{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "resources/js/**/*", "resources/js/**/*.vue"],
  "exclude": ["resources/js/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./resources/js/*"],
      "@app-data": ["./resources/js/app-data.ts"],
      "@css/*": ["./resources/css/*"],
      "@components/*": ["./resources/js/components/*"],
      "@composables/*": ["./resources/js/composables/*"],
      "@features/*": ["./resources/js/features/*"],
      "@layouts/*": ["./resources/js/layouts/*"],
      "@services/*": ["./resources/js/services/*"],
      "@stores/*": ["./resources/js/stores/*"],
      "@types": ["./resources/js/types/index.ts"],
      "@ui/*": ["./resources/js/ui/*"],
      "@utils/*": ["./resources/js/utils/*"],
      "@views/*": ["./resources/js/views/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
