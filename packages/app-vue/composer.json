{
    "name": "spanvel/app-vue-package",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "AppVuePackage\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AppVuePackage\\AppVuePackageServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
