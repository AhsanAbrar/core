{
    "name": "spanvel/[[name]]",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "[[rootNamespaceComposer]]\\": "src/"
        },
        "test-names": {
            "name": "[[name]]",
            "rootNamespace": "[[rootNamespace]]",
            "rootNamespaceComposer": "[[rootNamespaceComposer]]",
            "pascalName": "[[pascalName]]",
            "title": "[[title]]"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "[[rootNamespaceComposer]]\\[[rootNamespaceComposer]]ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
