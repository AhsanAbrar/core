{
    "name": "spanvel/vue-package-dev",
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "VuePackageDev\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VuePackageDev\\VuePackageDevServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
